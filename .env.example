# ==============================================
# Core application
# ==============================================
NODE_ENV="development"
APP_URL="YOUR DOMAIN"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_DEBUG="true"
LOG_LEVEL="debug"

# ==============================================
# Database
# ==============================================
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ==============================================
# Session / auth secrets (32+ chars recommended)
# The app accepts APP_SESSION_SECRET or AUTH_SECRET.
# APP_SESSION_SECRET is preferred.
# ==============================================
APP_SESSION_SECRET="replace-with-a-long-random-secret"
AUTH_SECRET="replace-with-a-long-random-secret"

# ==============================================
# Pi auth / payments
# ==============================================
NEXT_PUBLIC_PI_API_KEY=""
PI_SERVER_API_KEY=""
NEXT_PUBLIC_PI_SANDBOX="true"
PI_PAYMENT_TESTNET_ONLY="true"
PI_SUPERADMIN_USERNAMES=""
PI_SUPERADMIN_UIDS=""
PI_ADMIN_USERNAMES=""
PI_ADMIN_UIDS=""

# ==============================================
# IPFS / Pinata
# ==============================================
PINATA_JWT=""
PINATA_GATEWAY_URL="https://gateway.pinata.cloud/ipfs"

# ==============================================
# Protected internal routes
# ==============================================
HEALTHCHECK_SECRET=""
MAINTENANCE_API_SECRET=""

# ==============================================
# Sentry observability
# ==============================================
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
SENTRY_ENVIRONMENT="development"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
SENTRY_RELEASE=""
NEXT_PUBLIC_SENTRY_RELEASE=""
SENTRY_TRACES_SAMPLE_RATE="0.2"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.2"
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE="0"
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE="1"
